{
    "manifest_version": 3,
    "name": "Parfumshop Assistant",
    "short_name": "PS Assistant",
    "version": "0.9.0",
    "key": "",
    "description": "Operatorlar üçün yan panel: müştəri, ətir axtarışı, poster.",
    "action": {
        "default_title": "Parfumshop Assistant",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://web.whatsapp.com/*"
            ],
            "js": [
                "whatsapp.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "sidePanel",
        "storage",
        "tabs",
        "contextMenus",
        "scripting"
    ],
    "host_permissions": [
        "https://last.parfumshop.az/*",
        "http://localhost/*",
        "http://*.test/*",
        "https://*.test/*",
        "https://web.whatsapp.com/*",
        "https://business.facebook.com/*",
        "https://*.fbcdn.net/*",
        "https://*.cdninstagram.com/*"
    ],
    "minimum_chrome_version": "102"
}
